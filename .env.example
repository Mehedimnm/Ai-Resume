# MNM AI Resume - Environment Variables
#
# The app works out-of-the-box with a built-in smart generator (no key required).
# To enable real LLM generation, set ONE of the providers below.

# --- Option A: Google Gemini (recommended, used by default if set) ---
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest

# --- Option B: OpenAI-compatible API ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option B: AWS Bedrock (recommended for AWS Activate) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxx
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Public site URL (used for metadata / SEO)
NEXT_PUBLIC_SITE_URL=https://mehedihasanbd.dev

# --- Authentication ---
# Secret used to sign session cookies. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Database (MongoDB Atlas) ---
# Used for user accounts (login / signup).
# IMPORTANT: if your password contains special characters (@ : / ? # % $ etc.)
# you must percent-encode them in the URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mnm_ai_resume
